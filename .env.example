# Copy file này thành .env rồi sửa nếu cần:  cp .env.example .env
# Docker Compose tự đọc .env, KHÔNG commit file .env lên git.

# ---- Tài khoản PostgreSQL cho cả 3 database ----
DB_USER=postgres
DB_PASSWORD=postgres

# Port expose ra máy (không dùng 5432 để tránh đụng PostgreSQL cài local)
AUTH_DB_PORT=5433
USER_DB_PORT=5434
BOOKING_DB_PORT=5435

# ---- Tài khoản admin tạo sẵn lúc khởi động auth-service ----
# Bỏ trống ADMIN_EMAIL thì không tạo tài khoản admin nào.
# Tài khoản này dùng để đăng nhập vào các API /api/admin/** .
ADMIN_EMAIL=admin@ridebooking.local
# CHỈ dùng giá trị dưới đây cho local. Khi deploy thật phải đổi, nếu không
# auth-service sẽ in cảnh báo bảo mật vào log lúc khởi động.
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Quản trị viên

# ---- Bảo mật ----
# Tối thiểu 32 ký tự, auth-service và user-service BẮT BUỘC dùng chung
JWT_SECRET=thay-bang-chuoi-ngau-nhien-toi-thieu-32-ky-tu
# Khoá header X-Internal-Key, hai service BẮT BUỘC dùng chung
INTERNAL_API_KEY=thay-bang-khoa-noi-bo-cua-ban

# ---- Hạn token (phút / ngày) ----
# Access token sống ngắn, client tự gọi POST /api/auth/refresh khi hết hạn
JWT_EXPIRATION_MINUTES=15
# Refresh token sống 7 ngày, chỉ lưu SHA-256 trong bảng auth_db.refresh_tokens
JWT_REFRESH_TOKEN_DAYS=7

# ---- Chống brute-force ----
# KHÔNG khoá tài khoản, chỉ khoá CẶP (email + IP). Lý do: nếu khoá theo tài
# khoản, kẻ tấn công chỉ cần biết trước email của bạn là có thể khoá tài khoản
# đó vĩnh viễn (DoS), dù chưa từng đoán đúng mật khẩu.
# Sai LOGIN_MAX_FAILED_ATTEMPTS lần cho cùng một cặp trong LOGIN_LOCK_MINUTES
# phút thì chặn đúng cặp đó, các IP khác vẫn đăng nhập được bình thường.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Giới hạn thứ hai theo IP, chốn việc dò quét nhiều email từ một máy.
LOGIN_MAX_FAILED_ATTEMPTS_PER_IP=20
LOGIN_IP_WINDOW_MINUTES=15
# Admin gỡ khoá bằng PATCH /api/admin/users/{id}/unlock
LOGIN_ADMIN_UNLOCK_ENABLED=true

# ---- Gửi email (SMTP) ----
# Bỏ trống MAIL_HOST thì mặc định dùng mailpit trong docker-compose.
# Gửi thật, ví dụ Gmail (dùng App Password, KHÔNG dùng mật khẩu tài khoản):
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_STARTTLS=true
#   MAIL_USERNAME=<tài khoản gmail>
#   MAIL_PASSWORD=<app password>
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_STARTTLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@ridebooking.local
MAIL_FROM_NAME=Ride Booking
# Nhận cảnh báo bảo mật (đổi email, phát hiện đăng nhập lạ). Bỏ trống = gửi
# cho chính MAIL_FROM.
MAIL_SECURITY_TO=

# ---- Xác minh & khôi phục qua email ----
# Domain của frontend, dùng để dựng link trong email
APP_FRONTEND_URL=http://localhost:5173
# true = chỉ cho đăng nhập tài khoản đã xác minh email. Bật ở production;
# nhưng nhớ user đã có sẵn từ trước khi bật đều đang unverified, phải gửi
# mail mời xác minh lại cho họ trước.
EMAIL_VERIFY_REQUIRED_FOR_LOGIN=false
# Thời hạn token (phút). Xác minh 1 ngày, reset 30 phút, đổi email 1 giờ
EMAIL_VERIFY_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_CHANGE_TTL_MINUTES=60
# Hạn mức gửi email: theo người nhận và theo IP, trong EMAIL_RESEND_WINDOW_MINUTES.
# KHÔNG đặt giới hạn theo IP quá thấp — cả văn phòng có thể dùng chung 1 IP.
EMAIL_MAX_PER_EMAIL=3
EMAIL_MAX_PER_IP=30
# Trong docker-compose mọi request đều mang IP của gateway nên compose đặt
# riêng EMAIL_MAX_PER_IP=200 cho dev; biến ở đây chỉ áp dụng khi chạy ngoài
# compose hoặc khi muốn ghi đè.
EMAIL_RESEND_WINDOW_MINUTES=60
# Xoá lịch sử gửi và token đã dùng/hết hạn sau N ngày
EMAIL_HISTORY_RETENTION_DAYS=7

# ---- CORS ----
# Chỉ các origin này được gọi API. Production đổi thành domain thật.
# Phân cách nhiều origin bằng dấu phẩy, KHÔNG dùng dấu *.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- IP thật của client sau proxy (X-Forwarded-For) ----
# Giới hạn đăng nhập sai và hạn mức gửi email đều gắn với IP. Nếu IP ghi sai
# thì hai hạn mức này vô hiệu: hoặc thành hạn mức toàn cục, hoặc bị né tránh.
# Hai khoá dưới đây phải KHỚP với nhau, và phải là IP thật của tầng proxy.
#
# 1) Gateway: TCP peer mà gateway nhìn thấy (đo bằng log TRACE ở
#    org.springframework.cloud.gateway.filter.headers). Nếu không khớp, gateway
#    XOÁ X-Forwarded-For do client gửi rồi dừng luôn, không ghi IP thật.
#    - Docker Desktop trên macOS/Windows : 192.168.65.1
#    - Docker trên Linux                : 172.28.0.1
#    - Production sau nginx/ALB         : IP của nginx/ALB
GATEWAY_TRUSTED_PROXIES=(192\.168\.65\.1|172\.28\.0\.1|127\.0\.0\.1)

# 2) auth-service: chỉ tin IP của chính gateway. Đây là ranh giới bảo mật thật:
#    Tomcat mặc định coi CẢ dải 172.16/12 là proxy nội bộ, mà dải đó chính là
#    Docker network — nên ai gọi thẳng cũng dán X-Forwarded-For giả được.
#    Production: đổi sang đúng IP của gateway/nginx.
AUTH_TRUSTED_PROXY_IPS=172\.28\.0\.10

# 3) IP tĩnh của gateway + subnet cố định của Docker network.
#    Bắt buộc phải cố định: IP gateway đổi sau mỗi lần compose up thì
#    AUTH_TRUSTED_PROXY_IPS ở trên không còn khớp, và mọi request sẽ bị ghi
#    cùng một IP. Subnet cố định cũng giúp cấu hình không đổi giữa các máy.
GATEWAY_IP=172.28.0.10
DOCKER_SUBNET=172.28.0.0/24

# ---- JPA / schema ----
# update  : mặc định local, Hibernate tự tạo và sửa bảng
# validate: production, KHÔNG sửa schema — phải chạy database/*.sql một lần trước
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# ---- Nghiệp vụ đặt vé ----
# Thời gian giữ ghế. Dùng cho CẢ HAI chỗ: đồng hồ đếm ngược trên header Trang
# Chọn chỗ (requirement.md nói 10 phút) và job trả ghế về AVAILABLE.
# Hai chỗ này phải lấy cùng một biến, nếu không sẽ thành: đồng hồ báo hết giờ
# nhưng ghế vẫn bị giữ, hoặc ngược lại ghế được trả sớm khi khách còn đang
# thanh toán.
SEAT_HOLD_MINUTES=10

# ---- Stripe (payment-service) ----
# Khoá bí mật của tài khoản Stripe. Bắt đầu bằng sk_test_ (test) hoặc sk_live_.
# Lấy ở Dashboard > Developers > API keys. Để trống thì service vẫn lên nhưng
# mọi lời gọi tạo phiên thanh toán trả 502 kèm thông báo rõ ràng.
STRIPE_SECRET_KEY=
# Bí mật ký webhook của ĐÚNG endpoint trỏ tới payment-service. Mỗi endpoint có
# một whsec_ riêng nên phải tạo/lấy lại, không dùng chung với hệ thống khác.
# Lấy ở Dashboard > Developers > Webhooks, hoặc khi chạy:
#   stripe listen --forward-to localhost:8084/api/payments/webhook
STRIPE_WEBHOOK_SECRET=
# VND là tiền tệ 0 chữ số thập phân. Đổi đơn vị khác phải xem lại cách gửi
# unit_amount cho Stripe.
STRIPE_CURRENCY=vnd
# Nơi Stripe đưa khách về (đổi thành URL frontend thật khi deploy)
STRIPE_SUCCESS_URL=http://localhost:3000/my-bookings
STRIPE_CANCEL_URL=http://localhost:3000/booking/cancel