# Biến cho docker-compose.prod.yml (staging/production).
#   cp .env.prod.example .env.prod   → điền giá trị thật → KHÔNG commit .env.prod
#   docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# Biến nào để trống mà compose bắt buộc thì lệnh dừng và báo tên biến.
# Sinh chuỗi ngẫu nhiên: openssl rand -base64 48

# ---- Bảo mật (bắt buộc) ----
JWT_SECRET=
INTERNAL_API_KEY=

# ---- Domain ----
# Domain frontend (Vercel). Nhiều domain thì phân cách bằng dấu phẩy, KHÔNG dùng *
CORS_ALLOWED_ORIGINS=https://xego-staging.vercel.app
# Link trong email xác minh / quên mật khẩu
APP_FRONTEND_URL=https://xego-staging.vercel.app
# Stripe quay về sau khi thanh toán: trang /dat-ve/ket-qua của frontend (Thái kiểm lại tham số trang này đọc)
STRIPE_SUCCESS_URL=https://xego-staging.vercel.app/dat-ve/ket-qua
STRIPE_CANCEL_URL=https://xego-staging.vercel.app/dat-ve/ket-qua?cancelled=true

# ---- Database ----
# Mặc định dùng 3 container Postgres trong compose.
DB_USER=postgres
DB_PASSWORD=
# Dùng Postgres ngoài (Neon/Render): bỏ comment và điền theo connection string.
# Neon: host dạng ep-xxx.ap-southeast-1.aws.neon.tech, user/password lấy ở dashboard.
# BOOKING_DB_HOST=
# BOOKING_DB_NAME=booking_db
# BOOKING_DB_USER=
# BOOKING_DB_PASSWORD=
# BOOKING_DB_URL_PARAMS=?sslmode=require
# (tương tự AUTH_DB_* và USER_DB_* — mỗi service một database riêng)

# ---- Tài khoản admin đầu tiên ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Quản trị viên

# ---- Email (SMTP thật, ví dụ Gmail App Password hoặc Brevo) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ---- Stripe (staging dùng khoá test sk_test_...) ----
STRIPE_SECRET_KEY=
# Tạo webhook trỏ về https://<api-domain>/api/payments/webhook rồi lấy whsec_...
STRIPE_WEBHOOK_SECRET=

# ---- Dữ liệu mẫu ----
# Staging: true ở lần chạy đầu để có chuyến/nhà xe demo. Production: false.
SEED_ENABLED=false
SEED_TRIP_TOPUP=false

# ---- Gateway ----
# 127.0.0.1 khi có nginx/Caddy phía trước (khuyến nghị, để có HTTPS).
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8088
